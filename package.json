{
  "name": "gatewright",
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source AI control plane + MCP: centralize models, skills, commands, budget and config in one point, consumable by any tool via MCP — with governance and observability built in.",
  "keywords": [
    "ai",
    "mcp",
    "control-plane",
    "ai-agents",
    "guardrails",
    "governance",
    "cli",
    "claude-code",
    "codex",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/rfsants001/gatewright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rfsants001/gatewright.git"
  },
  "bugs": {
    "url": "https://github.com/rfsants001/gatewright/issues"
  },
  "bin": {
    "gate": "./dist/cli/gate.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/gate.ts",
    "start": "node dist/cli/gate.js",
    "gate": "node dist/cli/gate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "figlet": "^1.12.0",
    "figures": "^6.1.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  }
}

{
  "name": "gatewright",
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source AI control plane + MCP: centralize models, skills, commands, budget and config in one point, consumable by any tool via MCP — with governance and observability built in.",
  "keywords": [
    "ai",
    "mcp",
    "control-plane",
    "ai-agents",
    "guardrails",
    "governance",
    "cli",
    "claude-code",
    "codex",
    "llm"
  ],
  "author": {
    "name": "Rafael Santos",
    "email": "rf.sants001@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/rfsants001/gatewright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rfsants001/gatewright.git"
  },
  "bugs": {
    "url": "https://github.com/rfsants001/gatewright/issues"
  },
  "main": "dist/desktop/main.mjs",
  "bin": {
    "gate": "./dist/cli/gate.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/jev",
    "desktop/install-launcher.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node desktop/build.mjs",
    "dev": "tsx src/cli/gate.ts",
    "start": "node dist/cli/gate.js",
    "gate": "node dist/cli/gate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:watch": "npm run build",
    "test:watch": "vitest",
    "desktop": "node dist/cli/gate.js desktop",
    "desktop:dev": "npm run build && npm run desktop --",
    "test:desktop": "node desktop/smoke.mjs",
    "test:desktop:pending": "npm run build && node desktop/pending-smoke.mjs",
    "desktop:install": "node desktop/install-launcher.mjs",
    "test:desktop:evolution": "npm run build && node desktop/evolution-smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:linux:all": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "electron": "45.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "0.28.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "figlet": "^1.12.0",
    "figures": "^6.1.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "1.73.0",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  }
}
